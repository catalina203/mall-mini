# ===== 数据库（必需） =====
DB_URL=jdbc:mysql://localhost:3306/mall_mini?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=mallmini
DB_PASSWORD=change-me

# ===== 服务端 =====
SERVER_PORT=8080
# JWT 密钥：至少 32 字节随机字符串，生产环境必须替换（可用 openssl rand -base64 48 生成）
JWT_SECRET=dev-only-change-this-secret-at-least-32-bytes-long
JWT_EXPIRE_MINUTES=1440

# 开发登录与模拟支付：仅 dev profile 可开启，生产必须为 false
APP_DEV_LOGIN_ENABLED=true
APP_PAYMENT_MOCK_ENABLED=true

# 业务规则
APP_FREE_SHIPPING_THRESHOLD=99.00
APP_SHIPPING_FEE=10.00
APP_ORDER_CANCEL_MINUTES=30
APP_AUTO_CANCEL_ENABLED=true

# 本地图片存储目录（相对 server 运行目录）
APP_STORAGE_LOCAL_DIR=./uploads

# ===== 微信（可选，缺失时使用开发登录） =====
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 管理员初始化（可选，仅首次启动且库中无管理员时生效） =====
APP_ADMIN_INIT_USERNAME=admin
APP_ADMIN_INIT_PASSWORD=

# ===== 管理后台（Vite） =====
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ===== Docker Compose（可选） =====
MYSQL_ROOT_PASSWORD=root_dev_only
MYSQL_DATABASE=mall_mini
MYSQL_USER=mallmini
MYSQL_PASSWORD=mallmini_dev
MYSQL_PORT=3307
