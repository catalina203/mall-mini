.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  box-shadow: 0 -2rpx 16rpx rgb(31 35 41 / 6%);
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 0 12rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.indicator {
  width: 28rpx;
  height: 8rpx;
  background: transparent;
  border-radius: 999rpx;
}

.tab-item.active {
  color: #d9482b;
  font-weight: 600;
}

.tab-item.active .indicator {
  background: #d9482b;
}
