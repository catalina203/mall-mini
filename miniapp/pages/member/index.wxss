.member-page { padding-top: 16rpx; }
.state { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 80rpx 0; color: #6b7280; font-size: 26rpx; }
.state-hint { color: #9ca3af; font-size: 23rpx; }
.primary { margin: 0; color: #fff; background: #d9482b; border: none; }
.member-card { padding: 30rpx; margin-bottom: 20rpx; color: #fff; background: linear-gradient(135deg, #2b211a, #4a3425); border-radius: 18rpx; }
.member-head { display: flex; align-items: baseline; justify-content: space-between; }
.level { font-size: 32rpx; font-weight: 600; }
.points { color: #f4a284; font-family: Georgia, serif; font-size: 52rpx; }
.unit { font-family: inherit; font-size: 22rpx; }
.progress { height: 10rpx; margin: 20rpx 0 12rpx; overflow: hidden; background: rgb(255 255 255 / 18%); border-radius: 999rpx; }
.progress-bar { height: 100%; background: linear-gradient(90deg, #ef8a63, #f4c08a); border-radius: 999rpx; }
.progress-text { font-size: 22rpx; color: rgb(255 255 255 / 68%); }
.rules { display: flex; flex-direction: column; gap: 8rpx; padding: 24rpx; margin-bottom: 20rpx; color: #6b7280; font-size: 23rpx; line-height: 1.6; background: #fff; border-radius: 16rpx; }
.rules-title { color: #1f2329; font-size: 27rpx; font-weight: 600; }
.logs-card { padding: 24rpx; background: #fff; border-radius: 16rpx; }
.logs-title { display: block; margin-bottom: 12rpx; color: #1f2329; font-size: 27rpx; font-weight: 600; }
.log-item { display: flex; justify-content: space-between; gap: 16rpx; padding: 18rpx 0; border-top: 1rpx solid #f1f2f4; }
.log-main { display: flex; flex-direction: column; gap: 4rpx; }
.log-type { color: #1f2329; font-size: 25rpx; }
.log-time { color: #9ca3af; font-size: 21rpx; }
.log-remark { color: #6b7280; font-size: 22rpx; }
.log-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.delta { font-size: 27rpx; font-weight: 600; }
.delta-plus { color: #d9482b; }
.delta-minus { color: #047857; }
.balance { color: #9ca3af; font-size: 20rpx; }
