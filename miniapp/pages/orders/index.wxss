.orders-page {
  padding-top: 16rpx;
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 90rpx 0;
  color: #6b7280;
  font-size: 26rpx;
}

.state-hint {
  color: #9ca3af;
  font-size: 23rpx;
}

.primary {
  margin: 0;
  color: #ffffff;
  background: #d9482b;
  border: none;
}

.tabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.tab {
  display: inline-block;
  padding: 12rpx 26rpx;
  margin-right: 12rpx;
  color: #6b7280;
  font-size: 25rpx;
  background: #ffffff;
  border-radius: 999rpx;
}

.tab-active {
  color: #ffffff;
  font-weight: 600;
  background: #d9482b;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f1f2f4;
}

.order-no {
  color: #9ca3af;
  font-size: 22rpx;
}

.status {
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
}

.status-pending-payment {
  color: #b93a22;
  background: #fdf2ee;
}

.status-pending-shipment {
  color: #b45309;
  background: #fff7ed;
}

.status-pending-receipt {
  color: #1d4ed8;
  background: #eff6ff;
}

.status-completed {
  color: #047857;
  background: #ecfdf5;
}

.status-cancelled {
  color: #6b7280;
  background: #f3f4f6;
}

.order-body {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.thumb {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.order-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.product-name {
  overflow: hidden;
  color: #1f2329;
  font-size: 27rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quantity,
.time {
  color: #9ca3af;
  font-size: 22rpx;
}

.amount {
  color: #d9482b;
  font-size: 29rpx;
  font-weight: 600;
}

.order-foot {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f1f2f4;
}

.hint {
  color: #9ca3af;
  font-size: 21rpx;
}

.actions {
  display: flex;
  justify-content: flex-end;
  gap: 24rpx;
}

.action {
  color: #4b5563;
  font-size: 24rpx;
}

.action.detail {
  color: #d9482b;
}

.footer {
  padding: 30rpx 0 10rpx;
  color: #9ca3af;
  font-size: 24rpx;
  text-align: center;
}
