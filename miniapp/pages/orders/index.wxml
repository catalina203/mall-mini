<view class="page orders-page">
  <view wx:if="{{!loggedIn}}" class="state">
    <text>登录后查看订单</text>
    <button size="mini" class="primary" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
    <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{tabs}}"
        wx:key="value"
        class="tab {{activeStatus == item.value ? 'tab-active' : ''}}"
        data-status="{{item.value}}"
        bindtap="switchStatus"
      >
        {{item.label}}
      </view>
    </scroll-view>

    <view wx:if="{{loading}}" class="state">
      <text>正在加载…</text>
    </view>

    <view wx:elif="{{error}}" class="state">
      <text>{{error}}</text>
      <button size="mini" bindtap="retry">重试</button>
    </view>

    <block wx:else>
      <view wx:if="{{orders.length}}" class="list">
        <view
          wx:for="{{orders}}"
          wx:key="orderNo"
          class="order-card"
          data-order-no="{{item.orderNo}}"
          bindtap="openDetail"
        >
          <view class="order-head">
            <text class="order-no">{{item.orderNo}}</text>
            <text class="status {{item.statusClass}}">{{item.statusText}}</text>
          </view>
          <view class="order-body">
            <fallback-image class="thumb" src="{{item.firstProductImage}}" />
            <view class="order-info">
              <text class="product-name">{{item.firstProductName}}</text>
              <text class="quantity">共 {{item.totalQuantity}} 件</text>
              <text class="time">{{item.createdAtText}}</text>
            </view>
            <text class="amount">{{item.amountText}}</text>
          </view>
          <view class="order-foot">
            <text class="hint">订单号 {{item.orderNo}}</text>
            <view class="actions">
              <text
                wx:if="{{item.status == 'PENDING_PAYMENT'}}"
                class="action detail"
                data-order-no="{{item.orderNo}}"
                catchtap="openDetail"
              >去支付</text>
              <text
                wx:if="{{item.status == 'PENDING_PAYMENT'}}"
                class="action"
                data-order-no="{{item.orderNo}}"
                catchtap="cancelOrder"
              >取消订单</text>
              <text
                wx:if="{{item.status == 'PENDING_RECEIPT'}}"
                class="action"
                data-order-no="{{item.orderNo}}"
                catchtap="confirmReceipt"
              >确认收货</text>
              <text class="action detail" data-order-no="{{item.orderNo}}" catchtap="openDetail">查看详情</text>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="state">
        <text>{{activeStatus ? '该状态下暂无订单' : '暂无订单'}}</text>
        <text class="state-hint">去首页挑选商品下单吧</text>
      </view>

      <view wx:if="{{orders.length}}" class="footer">
        <text wx:if="{{loadingMore}}">正在加载更多…</text>
        <text wx:elif="{{hasMore}}">上拉加载更多</text>
        <text wx:else>没有更多了</text>
      </view>
    </block>
  </block>
</view>
