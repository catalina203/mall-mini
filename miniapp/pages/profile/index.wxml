<view class="page">
  <view class="profile-card">
    <view class="avatar">{{avatarText}}</view>
    <view class="profile-main">
      <text class="nickname">{{user ? user.nickname : '未登录'}}</text>
      <text class="phone" wx:if="{{user && user.phone}}">{{user.phone}}</text>
      <text class="hint" wx:else>登录后可管理购物车、地址与订单</text>
    </view>
    <text wx:if="{{loggedIn}}" class="logout" bindtap="onLogout">退出</text>
  </view>

  <view wx:if="{{loggedIn && user}}" class="member-bar" bindtap="openMember">
    <view class="member-left">
      <text class="member-level">{{user.memberLevelLabel}}</text>
      <text class="member-points">{{user.points}} 积分</text>
    </view>
    <text class="member-link">查看明细 ›</text>
  </view>

  <view wx:if="{{loading}}" class="state">
    <text>正在加载…</text>
  </view>

  <view wx:if="{{error}}" class="state">
    <text>{{error}}</text>
    <button size="mini" bindtap="refresh">重试</button>
  </view>

  <view wx:if="{{!loggedIn}}" class="login-card">
    <text class="card-title">登录</text>
    <view class="dev-note">开发登录仅用于本地联调，不是真实微信登录；生产环境默认关闭。</view>
    <button class="dev-login" bindtap="onDevLogin" loading="{{loggingIn}}" disabled="{{loggingIn}}">
      开发登录（测试用）
    </button>
    <button class="wechat-login" bindtap="onWechatLogin" loading="{{loggingIn}}" disabled="{{loggingIn}}">
      微信登录（需服务端配置）
    </button>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="openOrders">
      <text>我的订单</text>
      <text class="menu-hint">查看全部</text>
    </view>
    <view class="menu-item" bindtap="openAfterSales">
      <text>售后服务</text>
      <text class="menu-hint">退款 / 退货</text>
    </view>
    <view class="menu-item" bindtap="openNotifications">
      <text>消息通知</text>
      <text class="menu-hint">查看</text>
    </view>
    <view class="menu-item" bindtap="openMember">
      <text>会员积分</text>
      <text class="menu-hint">等级 / 明细</text>
    </view>
    <view class="menu-item" bindtap="openCoupons">
      <text>我的优惠券</text>
      <text class="menu-hint">领券 / 查看</text>
    </view>
    <view class="menu-item" bindtap="openSupport">
      <text>联系客服</text>
      <text class="menu-hint">提交工单</text>
    </view>
    <view class="menu-item" bindtap="openFavorites">
      <text>我的收藏</text>
      <text class="menu-hint">查看</text>
    </view>
    <view class="menu-item" bindtap="openHistory">
      <text>浏览足迹</text>
      <text class="menu-hint">查看</text>
    </view>
    <view class="menu-item" bindtap="openAddresses">
      <text>收货地址</text>
      <text class="menu-hint">管理</text>
    </view>
    <view class="menu-item" bindtap="openAgreement" data-type="user">
      <text>用户协议</text>
      <text class="menu-hint">查看</text>
    </view>
    <view class="menu-item" bindtap="openAgreement" data-type="privacy">
      <text>隐私说明</text>
      <text class="menu-hint">查看</text>
    </view>
  </view>
</view>
