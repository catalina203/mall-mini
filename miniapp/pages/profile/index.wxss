.profile-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #d9482b 0%, #ef7b52 100%);
  border-radius: 20rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  color: #d9482b;
  font-size: 36rpx;
  font-weight: 600;
  background: #ffffff;
  border-radius: 50%;
}

.profile-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: 600;
}

.phone,
.hint {
  font-size: 24rpx;
  opacity: 0.9;
}

.logout {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border: 1rpx solid rgb(255 255 255 / 60%);
  border-radius: 999rpx;
}

.login-card,
.menu-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.card-title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.dev-note {
  margin: 16rpx 0;
  color: #8a3a26;
  font-size: 23rpx;
  line-height: 1.6;
}

.dev-login {
  margin-bottom: 16rpx;
  color: #ffffff;
  font-size: 27rpx;
  background: #d9482b;
  border: none;
}

.wechat-login {
  color: #d9482b;
  font-size: 27rpx;
  background: #fdf2ee;
  border: none;
}

.menu-card {
  padding: 0 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f1f2f4;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-hint {
  color: #9ca3af;
  font-size: 23rpx;
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 30rpx 0;
  color: #6b7280;
  font-size: 25rpx;
}


.member-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 26rpx;
  margin-bottom: 20rpx;
  color: #fff;
  background: linear-gradient(135deg, #2b211a, #4a3425);
  border-radius: 16rpx;
}

.member-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.member-level {
  font-size: 25rpx;
  font-weight: 600;
}

.member-points {
  color: #f4a284;
  font-size: 30rpx;
}

.member-link {
  color: rgb(255 255 255 / 68%);
  font-size: 22rpx;
}
