.checkout-page {
  padding-bottom: 220rpx;
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 90rpx 0;
  color: #6b7280;
  font-size: 26rpx;
}

.primary {
  margin: 0;
  color: #ffffff;
  background: #d9482b;
  border: none;
}

.card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.card-title {
  color: #1f2329;
  font-size: 29rpx;
  font-weight: 600;
}

.address-card {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.address-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.address-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.receiver {
  color: #1f2329;
  font-size: 29rpx;
  font-weight: 600;
}

.phone {
  color: #6b7280;
  font-size: 25rpx;
}

.address-text {
  color: #4b5563;
  font-size: 25rpx;
  line-height: 1.5;
}

.change {
  color: #d9482b;
  font-size: 24rpx;
}

.item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f2f4;
}

.thumb {
  flex-shrink: 0;
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
}

.item-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.item-name {
  overflow: hidden;
  color: #1f2329;
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-spec {
  color: #9ca3af;
  font-size: 23rpx;
}

.item-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-price {
  color: #d9482b;
  font-size: 26rpx;
}

.item-quantity {
  color: #9ca3af;
  font-size: 23rpx;
}

.item-subtotal {
  color: #1f2329;
  font-size: 26rpx;
  font-weight: 600;
}

.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #4b5563;
  font-size: 25rpx;
}

.amount-row.total {
  padding-top: 14rpx;
  margin-top: 4rpx;
  color: #1f2329;
  font-weight: 600;
  border-top: 1rpx solid #f1f2f4;
}

.total-value {
  color: #d9482b;
  font-size: 32rpx;
}

.shipping-tip {
  color: #9ca3af;
  font-size: 22rpx;
}

.pay-note {
  padding: 20rpx 24rpx;
  color: #8a3a26;
  font-size: 23rpx;
  line-height: 1.6;
  background: #fdf2ee;
  border-radius: 12rpx;
}

.submit-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgb(31 35 41 / 8%);
}

.submit-total {
  display: flex;
  flex: 1;
  align-items: baseline;
  gap: 8rpx;
}

.submit-label {
  color: #6b7280;
  font-size: 23rpx;
}

.submit-value {
  color: #d9482b;
  font-size: 34rpx;
  font-weight: 600;
}

.submit-button {
  margin: 0;
  padding: 0 46rpx;
  color: #ffffff;
  font-size: 27rpx;
  background: #d9482b;
  border: none;
  border-radius: 999rpx;
}

.overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgb(17 24 39 / 45%);
}

.sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 80vh;
  padding: 28rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
}

.sheet-title {
  padding-bottom: 16rpx;
  color: #1f2329;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.sheet-list {
  max-height: 55vh;
}

.sheet-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #eceff3;
  border-radius: 12rpx;
}

.sheet-item-active {
  border-color: #d9482b;
  background: #fdf2ee;
}

.sheet-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.default-tag {
  padding: 4rpx 12rpx;
  color: #d9482b;
  font-size: 20rpx;
  background: #fdf2ee;
  border-radius: 999rpx;
}

.sheet-address {
  color: #6b7280;
  font-size: 24rpx;
}

.sheet-add {
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 27rpx;
  background: #d9482b;
  border: none;
  border-radius: 999rpx;
}


.invoice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invoice-hint {
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 1.6;
}

.field {
  height: 76rpx;
  padding: 0 22rpx;
  color: #1f2329;
  font-size: 25rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}


.coupon-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.coupon-link {
  color: #d9482b;
  font-size: 23rpx;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.coupon-chip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #fdf2ee;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
}

.coupon-chip-active {
  border-color: #d9482b;
}

.coupon-chip-clear {
  justify-content: center;
  background: #f7f8fa;
}

.coupon-value {
  color: #d9482b;
  font-size: 28rpx;
  font-weight: 600;
}

.coupon-name {
  flex: 1;
  color: #1f2329;
  font-size: 24rpx;
}

.coupon-condition {
  color: #9ca3af;
  font-size: 21rpx;
}

.coupon-empty {
  color: #9ca3af;
  font-size: 23rpx;
}
