<view class="page checkout-page">
  <view wx:if="{{!loggedIn}}" class="state">
    <text>登录后确认订单</text>
    <button size="mini" class="primary" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
    <view wx:if="{{loading}}" class="state">
      <text>正在加载…</text>
    </view>

    <view wx:elif="{{error}}" class="state">
      <text>{{error}}</text>
      <button size="mini" bindtap="loadAddresses">重试</button>
    </view>

    <view wx:elif="{{!addresses.length}}" class="state">
      <text>请先添加收货地址</text>
      <button size="mini" class="primary" bindtap="addAddress">新增地址</button>
    </view>

    <block wx:elif="{{preview}}">
      <view class="card address-card" bindtap="chooseAddress">
        <view class="address-main">
          <view class="address-head">
            <text class="receiver">{{preview.address.receiverName}}</text>
            <text class="phone">{{preview.address.phone}}</text>
          </view>
          <text class="address-text">{{preview.addressText}}</text>
        </view>
        <text class="change">更换</text>
      </view>

      <view class="card">
        <view class="coupon-head">
          <text class="card-title">优惠券</text>
          <text class="coupon-link" bindtap="goCoupons">领券中心 ›</text>
        </view>
        <view wx:if="{{coupons.length}}" class="coupon-list">
          <view
            wx:for="{{coupons}}"
            wx:key="id"
            class="coupon-chip {{selectedCouponId == item.id ? 'coupon-chip-active' : ''}}"
            data-id="{{item.id}}"
            bindtap="selectCoupon"
          >
            <text class="coupon-value">{{item.valueText}}</text>
            <text class="coupon-name">{{item.name}}</text>
            <text class="coupon-condition">{{item.conditionText}}</text>
          </view>
          <view
            wx:if="{{selectedCouponId}}"
            class="coupon-chip coupon-chip-clear"
            bindtap="clearCoupon"
          >
            <text class="coupon-name">不使用优惠券</text>
          </view>
        </view>
        <text wx:else class="coupon-empty">暂无可用优惠券</text>
      </view>

      <view class="card">
        <text class="card-title">商品清单</text>
        <view wx:for="{{preview.items}}" wx:key="skuId" class="item">
          <fallback-image class="thumb" src="{{item.productImage}}" />
          <view class="item-info">
            <text class="item-name">{{item.productName}}</text>
            <text class="item-spec">{{item.skuSpec}}</text>
            <view class="item-row">
              <text class="item-price">{{item.priceText}}</text>
              <text class="item-quantity">× {{item.quantity}}</text>
            </view>
          </view>
          <text class="item-subtotal">{{item.subtotalText}}</text>
        </view>
      </view>

      <view class="card">
        <text class="card-title">金额明细</text>
        <view class="amount-row">
          <text>商品金额</text>
          <text>{{preview.goodsAmountText}}</text>
        </view>
        <view class="amount-row">
          <text>运费</text>
          <text>{{preview.shippingText}}</text>
        </view>
        <view wx:if="{{preview.hasDiscount}}" class="amount-row">
          <text>{{preview.discountLabel}}</text>
          <text>-{{preview.discountAmountText}}</text>
        </view>
        <view class="amount-row total">
          <text>应付金额</text>
          <text class="total-value">{{preview.payableText}}</text>
        </view>
        <text class="shipping-tip">{{preview.freeShippingText}}</text>
      </view>

      <view class="card">
        <view class="invoice-head">
          <text class="card-title">发票</text>
          <switch
            checked="{{invoiceRequired}}"
            color="#d9482b"
            bindchange="onInvoiceToggle"
          />
        </view>
        <text class="invoice-hint">当前仅记录开票信息，电子发票开具需后续接入。</text>
        <block wx:if="{{invoiceRequired}}">
          <input
            class="field"
            placeholder="发票抬头（个人或单位）"
            value="{{invoiceTitle}}"
            maxlength="128"
            bindinput="onInvoiceTitleInput"
          />
          <input
            class="field"
            placeholder="税号（个人可不填）"
            value="{{invoiceTaxNo}}"
            maxlength="64"
            bindinput="onInvoiceTaxInput"
          />
          <input
            class="field"
            placeholder="接收电子发票的邮箱"
            value="{{invoiceEmail}}"
            maxlength="128"
            type="text"
            bindinput="onInvoiceEmailInput"
          />
        </block>
      </view>

      <view class="pay-note">当前为开发环境模拟支付，下单后仍需在订单详情完成支付。</view>

      <view class="submit-bar">
        <view class="submit-total">
          <text class="submit-label">应付</text>
          <text class="submit-value">{{preview.payableText}}</text>
        </view>
        <button
          class="submit-button"
          bindtap="submit"
          loading="{{submitting}}"
          disabled="{{submitting}}"
        >
          提交订单
        </button>
      </view>
    </block>
  </block>

  <view wx:if="{{pickerVisible}}" class="overlay" catchtap="closePicker">
    <view class="sheet" catchtap="noop">
      <text class="sheet-title">选择收货地址</text>
      <scroll-view scroll-y class="sheet-list">
        <view
          wx:for="{{addresses}}"
          wx:key="id"
          class="sheet-item {{item.id == selectedAddressId ? 'sheet-item-active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectAddress"
        >
          <view class="sheet-head">
            <text class="receiver">{{item.receiverName}}</text>
            <text class="phone">{{item.phone}}</text>
            <text wx:if="{{item.isDefault}}" class="default-tag">默认</text>
          </view>
          <text class="sheet-address">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</text>
        </view>
      </scroll-view>
      <button class="sheet-add" bindtap="addAddress">新增收货地址</button>
    </view>
  </view>
</view>
