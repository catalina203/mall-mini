.support-page { padding-top: 16rpx; }
.state { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 60rpx 0; color: #6b7280; font-size: 26rpx; }
.primary { margin: 0; color: #fff; background: #d9482b; border: none; }
.card { display: flex; flex-direction: column; gap: 14rpx; padding: 26rpx; margin-bottom: 20rpx; background: #fff; border-radius: 16rpx; }
.card-title { color: #1f2329; font-size: 29rpx; font-weight: 600; }
.faq { display: flex; flex-direction: column; gap: 4rpx; padding-top: 12rpx; border-top: 1rpx solid #f1f2f4; }
.faq-q { color: #1f2329; font-size: 25rpx; font-weight: 500; }
.faq-a { color: #6b7280; font-size: 23rpx; line-height: 1.6; }
.picker-row { display: flex; justify-content: space-between; padding: 18rpx 22rpx; color: #1f2329; font-size: 25rpx; background: #f7f8fa; border-radius: 12rpx; }
.arrow { color: #9ca3af; }
.field { height: 76rpx; padding: 0 22rpx; color: #1f2329; font-size: 25rpx; background: #f7f8fa; border-radius: 12rpx; }
.textarea { width: 100%; min-height: 160rpx; padding: 20rpx; color: #1f2329; font-size: 25rpx; line-height: 1.6; background: #f7f8fa; border-radius: 12rpx; box-sizing: border-box; }
.submit { margin-top: 6rpx; color: #fff; font-size: 27rpx; background: #d9482b; border: none; border-radius: 999rpx; }
.ticket { display: flex; flex-direction: column; gap: 6rpx; padding-top: 18rpx; border-top: 1rpx solid #f1f2f4; }
.ticket-head { display: flex; justify-content: space-between; gap: 16rpx; }
.ticket-subject { flex: 1; color: #1f2329; font-size: 26rpx; font-weight: 600; }
.ticket-status { color: #d9482b; font-size: 22rpx; }
.ticket-meta { color: #9ca3af; font-size: 21rpx; }
.ticket-content { color: #4b5563; font-size: 24rpx; line-height: 1.6; }
.reply { display: flex; flex-direction: column; gap: 4rpx; padding: 14rpx 18rpx; margin-top: 6rpx; background: #f7f8fa; border-radius: 10rpx; }
.reply-label { color: #d9482b; font-size: 21rpx; }
.reply-content { color: #4b5563; font-size: 23rpx; line-height: 1.6; }
.ticket-foot { display: flex; justify-content: space-between; margin-top: 4rpx; }
.ticket-time { color: #9ca3af; font-size: 21rpx; }
.close { color: #9ca3af; font-size: 22rpx; }
