.review-page { padding-top: 16rpx; }
.state { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 80rpx 0; color: #6b7280; font-size: 26rpx; }
.primary { margin: 0; color: #fff; background: #d9482b; border: none; }
.card { display: flex; flex-direction: column; gap: 18rpx; padding: 28rpx; background: #fff; border-radius: 16rpx; }
.product { color: #1f2329; font-size: 29rpx; font-weight: 600; }
.rating-row { display: flex; align-items: center; gap: 8rpx; }
.star { color: #d1d5db; font-size: 48rpx; }
.star-active { color: #f59e0b; }
.rating-text { margin-left: 8rpx; color: #9ca3af; font-size: 23rpx; }
.textarea { width: 100%; min-height: 180rpx; padding: 20rpx; color: #1f2329; font-size: 25rpx; line-height: 1.6; background: #f7f8fa; border-radius: 12rpx; box-sizing: border-box; }
.anonymous-row { display: flex; align-items: center; justify-content: space-between; font-size: 25rpx; }
.hint { color: #9ca3af; font-size: 21rpx; }
.submit { margin-top: 8rpx; color: #fff; font-size: 27rpx; background: #d9482b; border: none; border-radius: 999rpx; }
