.list-page { padding-top: 16rpx; }
.state { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 80rpx 0; color: #6b7280; font-size: 26rpx; }
.state-hint { color: #9ca3af; font-size: 23rpx; }
.primary { margin: 0; color: #fff; background: #d9482b; border: none; }
.list { display: flex; flex-direction: column; gap: 16rpx; }
.item-card { display: flex; align-items: center; gap: 18rpx; padding: 22rpx; background: #fff; border-radius: 16rpx; }
.thumb { flex-shrink: 0; width: 140rpx; height: 140rpx; border-radius: 12rpx; }
.item-info { display: flex; flex: 1; flex-direction: column; gap: 6rpx; min-width: 0; }
.name { overflow: hidden; color: #1f2329; font-size: 27rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.subtitle { overflow: hidden; color: #9ca3af; font-size: 22rpx; text-overflow: ellipsis; white-space: nowrap; }
.price { color: #d9482b; font-size: 28rpx; font-weight: 600; }
.time { color: #9ca3af; font-size: 21rpx; }
.remove { color: #9ca3af; font-size: 22rpx; }
.footer { padding: 30rpx 0; color: #9ca3af; font-size: 23rpx; text-align: center; }
