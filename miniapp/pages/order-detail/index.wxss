.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 90rpx 0;
  color: #6b7280;
  font-size: 26rpx;
}

.primary {
  margin: 0;
  color: #ffffff;
  background: #d9482b;
  border: none;
}

.status-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  color: #ffffff;
  border-radius: 18rpx;
}

.status-card.status-pending-payment {
  background: linear-gradient(135deg, #d9482b, #ef7b52);
}

.status-card.status-pending-shipment {
  background: linear-gradient(135deg, #b45309, #d97706);
}

.status-card.status-pending-receipt {
  background: linear-gradient(135deg, #1d4ed8, #3b82f6);
}

.status-card.status-completed {
  background: linear-gradient(135deg, #047857, #10b981);
}

.status-card.status-cancelled {
  background: linear-gradient(135deg, #4b5563, #9ca3af);
}

.status-text {
  font-size: 36rpx;
  font-weight: 600;
}

.status-note {
  font-size: 24rpx;
  line-height: 1.5;
  opacity: 0.92;
}

.payment-text {
  font-size: 22rpx;
  opacity: 0.85;
}

.payment-box {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 18rpx;
  margin-top: 8rpx;
  background: rgb(255 255 255 / 16%);
  border-radius: 12rpx;
}

.payment-hint {
  font-size: 22rpx;
  line-height: 1.5;
  opacity: 0.92;
}

.pay-button {
  margin: 0;
  color: #b93a22;
  font-size: 25rpx;
  background: #ffffff;
  border: none;
  border-radius: 999rpx;
}

.status-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 10rpx;
}

.action-button {
  margin: 0;
  color: #b93a22;
  font-size: 23rpx;
  background: #ffffff;
  border: none;
  border-radius: 999rpx;
}

.action-button.danger {
  color: #ffffff;
  background: rgb(255 255 255 / 22%);
}

.card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.card-title {
  color: #1f2329;
  font-size: 29rpx;
  font-weight: 600;
}

.address-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.receiver {
  color: #1f2329;
  font-size: 29rpx;
  font-weight: 600;
}

.phone {
  color: #6b7280;
  font-size: 25rpx;
}

.address-text {
  color: #4b5563;
  font-size: 25rpx;
  line-height: 1.5;
}

.item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f2f4;
}

.thumb {
  flex-shrink: 0;
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
}

.item-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.item-name {
  overflow: hidden;
  color: #1f2329;
  font-size: 27rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-spec {
  color: #9ca3af;
  font-size: 23rpx;
}

.item-row {
  display: flex;
  gap: 16rpx;
}

.item-price {
  color: #d9482b;
  font-size: 25rpx;
}

.item-quantity {
  color: #9ca3af;
  font-size: 23rpx;
}

.item-subtotal {
  color: #1f2329;
  font-size: 26rpx;
  font-weight: 600;
}

.amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #4b5563;
  font-size: 25rpx;
}

.amount-row.total {
  padding-top: 14rpx;
  margin-top: 4rpx;
  color: #1f2329;
  font-weight: 600;
  border-top: 1rpx solid #f1f2f4;
}

.total-value {
  color: #d9482b;
  font-size: 32rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.info-row text:last-child {
  color: #1f2329;
  text-align: right;
  word-break: break-all;
}

.log-item {
  display: flex;
  gap: 16rpx;
}

.log-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 10rpx;
  background: #d9482b;
  border-radius: 50%;
}

.log-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.log-title {
  color: #1f2329;
  font-size: 25rpx;
}

.log-meta {
  color: #9ca3af;
  font-size: 21rpx;
}

.log-remark {
  color: #6b7280;
  font-size: 22rpx;
}
