.apply-page {
  padding-top: 16rpx;
  padding-bottom: 180rpx;
}

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 90rpx 0;
  color: #6b7280;
  font-size: 26rpx;
}

.primary {
  margin: 0;
  color: #ffffff;
  background: #d9482b;
  border: none;
}

.order-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 26rpx;
  margin-bottom: 20rpx;
  color: #6b7280;
  font-size: 23rpx;
  background: #ffffff;
  border-radius: 14rpx;
}

.mono {
  color: #1f2329;
  font-family: Menlo, Consolas, monospace;
  font-size: 22rpx;
}

.card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.card-title {
  color: #1f2329;
  font-size: 29rpx;
  font-weight: 600;
}

.type-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.type-option {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 20rpx;
  border: 2rpx solid #eceef1;
  border-radius: 14rpx;
}

.type-option.active {
  background: #fdf2ee;
  border-color: #d9482b;
}

.type-option.disabled {
  opacity: 0.45;
}

.type-name {
  color: #1f2329;
  font-size: 27rpx;
  font-weight: 600;
}

.type-desc {
  color: #9ca3af;
  font-size: 22rpx;
  line-height: 1.5;
}

.type-hint {
  color: #b45309;
  font-size: 22rpx;
}

.item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f2f4;
}

.select-dot {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #d1d5db;
  border-radius: 50%;
}

.select-dot.checked {
  background: #d9482b;
  border-color: #d9482b;
}

.thumb {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.item-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.item-name {
  overflow: hidden;
  color: #1f2329;
  font-size: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-spec {
  color: #9ca3af;
  font-size: 22rpx;
}

.item-price {
  color: #d9482b;
  font-size: 25rpx;
}

.quantity {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.step {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  color: #4b5563;
  font-size: 26rpx;
  background: #f3f4f6;
  border-radius: 50%;
}

.number {
  min-width: 40rpx;
  color: #1f2329;
  font-size: 25rpx;
  text-align: center;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 22rpx;
  color: #1f2329;
  font-size: 25rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}

.arrow {
  color: #9ca3af;
  font-size: 30rpx;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 22rpx;
  color: #1f2329;
  font-size: 25rpx;
  line-height: 1.6;
  background: #f7f8fa;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.submit-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 26rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -8rpx 30rpx rgb(17 24 39 / 6%);
}

.estimate {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.amount {
  color: #d9482b;
  font-size: 32rpx;
  font-weight: 600;
}

.hint {
  color: #9ca3af;
  font-size: 20rpx;
}

.submit-button {
  flex-shrink: 0;
  min-width: 220rpx;
  margin: 0;
  color: #ffffff;
  font-size: 27rpx;
  background: #d9482b;
  border: none;
  border-radius: 999rpx;
}
