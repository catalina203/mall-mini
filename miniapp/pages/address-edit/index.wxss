.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 90rpx 0;
  color: #6b7280;
  font-size: 26rpx;
}

.form-card {
  padding: 8rpx 28rpx 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.field {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f1f2f4;
}

.field-column {
  align-items: flex-start;
  flex-direction: column;
  gap: 12rpx;
}

.label {
  flex-shrink: 0;
  width: 150rpx;
  color: #1f2329;
  font-size: 27rpx;
}

.input,
.picker,
.textarea {
  flex: 1;
  width: 100%;
  color: #1f2329;
  font-size: 27rpx;
}

.picker.placeholder {
  color: #9ca3af;
}

.textarea {
  min-height: 120rpx;
  line-height: 1.6;
}

.field-hint {
  color: #9ca3af;
  font-size: 22rpx;
}

.switch-row {
  justify-content: space-between;
  border-bottom: none;
}

.switch-label {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: 27rpx;
}

.save {
  margin-top: 20rpx;
  color: #ffffff;
  font-size: 28rpx;
  background: #d9482b;
  border: none;
  border-radius: 999rpx;
}
