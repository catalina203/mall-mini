<view class="page">
  <view wx:if="{{loading}}" class="state">
    <text>正在加载…</text>
  </view>

  <view wx:elif="{{error}}" class="state">
    <text>{{error}}</text>
    <button size="mini" bindtap="retry">重试</button>
  </view>

  <view wx:else class="form-card">
    <view class="field">
      <text class="label">收货人</text>
      <input
        class="input"
        value="{{form.receiverName}}"
        placeholder="请输入收货人姓名"
        maxlength="64"
        bindinput="onNameInput"
      />
    </view>

    <view class="field">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        value="{{form.phone}}"
        placeholder="请输入 11 位手机号"
        maxlength="11"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="field">
      <text class="label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegionChange">
        <view class="picker {{regionText ? '' : 'placeholder'}}">
          {{regionText || '请选择省 / 市 / 区'}}
        </view>
      </picker>
    </view>

    <view class="field field-column">
      <text class="label">详细地址</text>
      <textarea
        class="textarea"
        value="{{form.detail}}"
        placeholder="街道、门牌号等"
        maxlength="255"
        auto-height
        bindinput="onDetailInput"
      />
    </view>

    <view class="field switch-row">
      <view class="switch-label">
        <text>设为默认地址</text>
        <text class="field-hint">下单时优先使用</text>
      </view>
      <switch checked="{{form.isDefault}}" color="#d9482b" bindchange="onDefaultChange" />
    </view>

    <button class="save" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存地址</button>
  </view>
</view>
