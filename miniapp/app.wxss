page {
  min-height: 100%;
  background: #f5f6f8;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 180rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #d9482b 0%, #ef7b52 100%);
  border-radius: 20rpx;
}

.hero-brand {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-sub {
  font-size: 24rpx;
  opacity: 0.9;
}

.panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.desc {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.6;
}

.tag {
  align-self: flex-start;
  padding: 6rpx 16rpx;
  color: #d9482b;
  font-size: 22rpx;
  background: #fdf2ee;
  border-radius: 999rpx;
}
