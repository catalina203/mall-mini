:host {
  display: block;
}

.card {
  overflow: hidden;
  background: #ffffff;
  border-radius: 16rpx;
}

.image {
  display: block;
  width: 100%;
  height: 300rpx;
}

.body {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx;
}

.name {
  overflow: hidden;
  color: #1f2329;
  font-size: 28rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.subtitle {
  overflow: hidden;
  color: #9ca3af;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price {
  color: #d9482b;
  font-size: 30rpx;
  font-weight: 600;
}

.stock {
  color: #9ca3af;
  font-size: 22rpx;
}
