# ===== MallMini 本地开发环境变量 =====
# 使用方式：cp .env.example .env，然后在 server 目录执行 ./run-dev.sh
# .env 已被 .gitignore 忽略，不要提交真实密钥。

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# 本地 Docker MySQL（docker compose 暴露 3307）
DB_URL='jdbc:mysql://localhost:3307/mall_mini?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true'
DB_USERNAME=mallmini
DB_PASSWORD=mallmini_dev

# 开发登录与模拟支付：仅 dev 可用
APP_DEV_LOGIN_ENABLED=true
APP_PAYMENT_MOCK_ENABLED=true

# 业务规则
APP_SHIPPING_FEE=10.00
APP_FREE_SHIPPING_THRESHOLD=99.00
APP_ORDER_CANCEL_MINUTES=30
APP_AUTO_CANCEL_ENABLED=true
APP_ORDER_AUTO_CONFIRM_ENABLED=true
APP_ORDER_AUTO_CONFIRM_DAYS=7
APP_STOCK_ALERT_THRESHOLD=10

# 本地图片目录
APP_STORAGE_LOCAL_DIR=./uploads

# 管理后台跨域
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 微信登录（可选，缺失时使用开发登录）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 首次初始化管理员（可选，库中已有管理员时忽略）
# APP_ADMIN_INIT_USERNAME=admin
# APP_ADMIN_INIT_PASSWORD=
